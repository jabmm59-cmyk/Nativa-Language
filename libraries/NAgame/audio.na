NA imp native.NAgame.audio as _au

classify Sound: (
    df __init__(urself, handle, path): (
        urself.kind = "sound"
        urself.handle = handle
        urself.path = path
    )
)

df loadmsc(file): (
    _au.load_music(file)
)

df playmsc(file = None): (
    _au.play_music(file)
)

df pausemsc(): (
    _au.pause_music()
)

df stopmsc(): (
    _au.stop_music()
)

df loopmsc(file = None): (
    _au.loop_music(file)
)

df volmsc(value): (
    _au.set_music_volume(value)
)

df vlint(value): (
    _au.set_sfx_volume(value)
)

df loadsnd(file): (
    ret Sound(_au.load_sound(file), file)
)

df playsnd(file): (
    if typeof(file) == "str": (
        _au.play_sound(_au.load_sound(file))
    )
    else: (
        _au.play_sound(file.handle)
    )
)
