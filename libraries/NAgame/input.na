NA imp native.NAgame.input as _inp

df key(name, once = False): (
    if once: (
        ret _inp.keyhit(name)
    )
    ret _inp.key(name)
)

df keyout(name): (
    ret _inp.keyout(name)
)

df mse(): (
    ret _inp.mse()
)

df mseclk(button = 1): (
    ret _inp.mseclk(button)
)

df mseout(button = 1): (
    ret _inp.mseout(button)
)

df controllr(index = 0): (
    data = _inp.controller(index)
    if data is None: (
        ret None
    )
    ret {"index": index, "axes": data[0], "buttons": data[1]}
)
