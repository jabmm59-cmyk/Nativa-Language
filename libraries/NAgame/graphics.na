NA imp native.NAgame.window as _win
NA imp native.NAgame.graphics as _gfx
NA imp NAgame.utils as _utils
NA imp NAgame.camera as _camera

df window(width, height): (
    _win.window(width, height)
)

df st_title(title): (
    _win.st_title(title)
)

df close(): (
    _win.close()
)

df back(r, g, b): (
    _win.back(r, g, b)
)

df updt(): (
    step = _win.dt()
    _utils._run(_utils._updaters, step)
    _utils._run(_utils._overlays, step)
    if _utils._state["over"]: (
        _gfx.draw_overlay_message(_utils._state["message"])
    )
    _win.updt()
)

df evn(): (
    ret _win.evn()
)

df tof(fps): (
    ret _win.tof(fps)
)

df dt(): (
    ret _win.dt()
)

df gettime(): (
    ret _win.gettime()
)

df clr(r, g = None, b = None, a = 255): (
    ret _gfx.set_color(r, g, b, a)
)

df fntsz(size): (
    ret _gfx.set_font_size(size)
)

df rec(x, y, width, height, border = 0): (
    shape = _utils.Shape("rec", x, y, width, height, 0)
    shape.color = _gfx.get_color()
    shape.border = border
    draw(shape)
    ret shape
)

df circ(x, y, radius, border = 0): (
    shape = _utils.Shape("circ", x, y, radius * 2, radius * 2, radius)
    shape.color = _gfx.get_color()
    shape.border = border
    draw(shape)
    ret shape
)

df lne(x1, y1, x2, y2, thickness = 1): (
    shape = _utils.Shape("lne", x1, y1, abs(x2 - x1), abs(y2 - y1), 0)
    shape.color = _gfx.get_color()
    shape.x2 = x2
    shape.y2 = y2
    shape.thickness = thickness
    draw(shape)
    ret shape
)

df txt(text, x, y): (
    size = _gfx.get_font_size()
    dimensions = _gfx.text_size(str(text), size)
    shape = _utils.Shape("txt", x, y, dimensions[0], dimensions[1], 0)
    shape.color = _gfx.get_color()
    shape.text = str(text)
    shape.size = size
    draw(shape)
    ret shape
)

df draw(obj, ui = False): (
    kind = obj.kind
    if kind == "rec": (
        _gfx.draw_rec(obj.x, obj.y, obj.width, obj.height, obj.border, obj.color, ui)
    )
    else if kind == "circ": (
        _gfx.draw_circ(obj.x, obj.y, obj.radius, obj.border, obj.color, ui)
    )
    else if kind == "lne": (
        _gfx.draw_line(obj.x, obj.y, obj.x2, obj.y2, obj.thickness, obj.color, ui)
    )
    else if kind == "txt": (
        _gfx.draw_text(obj.text, obj.x, obj.y, obj.size, obj.color, ui)
    )
    else if kind == "image": (
        _gfx.draw_image(obj.handle, obj.x, obj.y, obj.width, obj.height, 0, 255, False, False, ui)
    )
    else if kind == "sprite": (
        if obj.animation is not None: (
            obj.image = obj.animation.frame()
        )
        _gfx.draw_image(obj.image.handle, obj.x, obj.y, obj.width, obj.height, obj.angle, obj.alpha, obj.flipx, obj.flipy, ui)
    )
    else: (
        obj.render(ui)
    )
)

df loadimg(path): (
    data = _gfx.load_image(path)
    ret _utils.Image(data[0], data[1], data[2])
)

df shwimg(img, x, y): (
    _gfx.draw_image(img.handle, x, y, img.width, img.height, 0, 255, False, False, False)
)

df sprt(img, x = 0, y = 0): (
    ret _utils.Sprite(img, x, y)
)

df rsze(obj, width, height): (
    if obj.kind == "image": (
        data = _gfx.resize_image(obj.handle, width, height)
        ret _utils.Image(data[0], data[1], data[2])
    )
    obj.width = width
    obj.height = height
    ret obj
)

df rttae(obj, angle): (
    if obj.kind == "image": (
        data = _gfx.rotate_image(obj.handle, angle)
        ret _utils.Image(data[0], data[1], data[2])
    )
    obj.angle = angle
    ret obj
)

df alp(obj, value): (
    if value < 0 or value > 255: (
        perror ValueError("alp(): o valor deve estar entre 0 e 255")
    )
    if obj.kind == "image": (
        data = _gfx.set_image_alpha(obj.handle, value)
        ret _utils.Image(data[0], data[1], data[2])
    )
    obj.alpha = value
    ret obj
)

df flp(obj, horizontal = True, vertical = False): (
    if obj.kind == "image": (
        data = _gfx.flip_image(obj.handle, horizontal, vertical)
        ret _utils.Image(data[0], data[1], data[2])
    )
    if horizontal: (
        obj.flipx = not obj.flipx
    )
    if vertical: (
        obj.flipy = not obj.flipy
    )
    ret obj
)
