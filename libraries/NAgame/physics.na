NA imp native.NAgame.physics as _pc
NA imp native.NAgame.window as _win
NA imp NAgame.utils as _utils

grv = 980.0
_ground = None

_MATERIALS = {
    "rubber": {"friction": 2.0, "bounce": 0.85, "density": 1.1},
    "metal": {"friction": 1.0, "bounce": 0.2, "density": 7.8},
    "wood": {"friction": 3.0, "bounce": 0.35, "density": 0.7},
    "ice": {"friction": 0.1, "bounce": 0.1, "density": 0.9},
    "stone": {"friction": 4.0, "bounce": 0.15, "density": 2.5}
}

df _shape(obj): (
    if obj.kind == "circ": (
        ret ["circ", obj.x, obj.y, 0, 0, obj.radius]
    )
    ret ["rec", obj.x, obj.y, obj.width, obj.height, 0]
)

df colde(obj1, obj2): (
    ret _pc.collide(_shape(obj1), _shape(obj2))
)

df tch(obj1, obj2): (
    ret _pc.touch(_shape(obj1), _shape(obj2))
)

df ray(x1, y1, x2, y2, obstacles): (
    shapes = []
    for obstacle in obstacles: (
        shapes.append(_shape(obstacle))
    )
    hit = _pc.raycast(x1, y1, x2, y2, shapes)
    if hit is None: (
        ret None
    )
    ret {"obj": obstacles[hit[0]], "x": hit[1], "y": hit[2], "distance": hit[3]}
)

df mate(first, second = None): (
    if typeof(first) == "str": (
        ret _preset(first)
    )
    preset = _preset(second)
    first.friction = preset["friction"]
    first.bounce = preset["bounce"]
    first.mass = preset["density"]
    ret first
)

df _preset(name): (
    if name not in _MATERIALS: (
        perror ValueError("material desconhecido: " + str(name))
    )
    source = _MATERIALS[name]
    ret {"friction": source["friction"], "bounce": source["bounce"], "density": source["density"]}
)

df pos(obj, x, y): (
    obj.x = x
    obj.y = y
    ret obj
)

df getpos(obj): (
    ret [obj.x, obj.y]
)

df spd(obj, vx = None, vy = None): (
    if vx is None: (
        ret [obj.vx, obj.vy]
    )
    obj.vx = vx
    if vy is not None: (
        obj.vy = vy
    )
    ret obj
)

df acc(obj, ax = None, ay = None): (
    if ax is None: (
        ret [obj.ax, obj.ay]
    )
    obj.ax = ax
    if ay is not None: (
        obj.ay = ay
    )
    ret obj
)

df mass(obj, value = None): (
    if value is None: (
        ret obj.mass
    )
    if value <= 0: (
        perror ValueError("mass(): a massa deve ser maior que zero")
    )
    obj.mass = value
    ret obj
)

df fric(obj, value = None): (
    if value is None: (
        ret obj.friction
    )
    if value < 0: (
        perror ValueError("fric(): o atrito não pode ser negativo")
    )
    obj.friction = value
    ret obj
)

df bounc(obj, value = None): (
    if value is None: (
        ret obj.bounce
    )
    if value < 0 or value > 1: (
        perror ValueError("bounc(): o quique deve estar entre 0 e 1")
    )
    obj.bounce = value
    ret obj
)

df jmp(obj, force): (
    if not obj.on_ground: (
        ret False
    )
    obj.vy = 0 - force / obj.mass
    obj.on_ground = False
    ret True
)

df grnd(y = None): (
    glob _ground
    if y is None: (
        ret _ground
    )
    if y is False: (
        _ground = None
        ret None
    )
    _ground = y
    ret y
)

df phys(obj, step = None): (
    if step is None: (
        step = _win.dt()
    )
    obj.vx = obj.vx + obj.ax * step
    obj.vy = obj.vy + (grv * obj.gravity + obj.ay) * step
    if obj.on_ground: (
        obj.vx = obj.vx * max(0.0, 1.0 - obj.friction * step)
    )
    obj.x = obj.x + obj.vx * step
    obj.y = obj.y + obj.vy * step
    obj.on_ground = False
    if _ground is not None: (
        overlap = obj.bottom() - _ground
        if overlap >= 0: (
            obj.y = obj.y - overlap
            if obj.vy > 0: (
                if obj.bounce > 0 and obj.vy > 30: (
                    obj.vy = 0 - obj.vy * obj.bounce
                )
                else: (
                    obj.vy = 0.0
                    obj.on_ground = True
                )
            )
            else: (
                obj.on_ground = True
            )
        )
    )
    ret obj
)
