NA imp native.NAgame.particles as _pt
NA imp native.NAgame.graphics as _gfx
NA imp math as _math
NA imp NAgame.utils as _utils

classify ParticleSystem: (
    df __init__(urself, x, y, count, color, speed, life, size, gravity): (
        urself.kind = "particles"
        urself.color = color
        urself.gravity = gravity
        urself.particles = []
        for i in rang(count): (
            angle = _utils.rnd(0.0, 6.283185307179586)
            velocity = speed * _utils.rnd(0.3, 1.0)
            urself.particles.append([x, y, _math.cos(angle) * velocity, _math.sin(angle) * velocity, 0.0, life * _utils.rnd(0.5, 1.0), size])
        )
    )

    df update(urself, step): (
        alive = []
        for p in urself.particles: (
            p[4] = p[4] + step
            if p[4] < p[5]: (
                p[3] = p[3] + urself.gravity * step
                p[0] = p[0] + p[2] * step
                p[1] = p[1] + p[3] * step
                alive.append(p)
            )
        )
        urself.particles = alive
        ret len(alive) > 0
    )

    df render(urself, ui = False): (
        _pt.draw_particles(urself.particles, urself.color, ui)
    )

    df auto_render(urself, step): (
        urself.render(False)
        ret len(urself.particles) > 0
    )

    df finished(urself): (
        ret len(urself.particles) == 0
    )
)

df prt(x, y, count = 20, color = None, speed = 150, life = 1.0, size = 3, gravity = 200): (
    if count < 0: (
        perror ValueError("prt(): count não pode ser negativo")
    )
    if life <= 0: (
        perror ValueError("prt(): life deve ser maior que zero")
    )
    if color is None: (
        color = _gfx.get_color()
    )
    system = ParticleSystem(x, y, count, color, speed, life, size, gravity)
    _utils._register_updater(system.update)
    _utils._register_overlay(system.auto_render)
    ret system
)
