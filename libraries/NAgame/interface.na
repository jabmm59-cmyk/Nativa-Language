NA imp native.NAgame.interface as _ui
NA imp native.NAgame.input as _inp
NA imp json as _json
NA imp NAgame.utils as _utils
NA imp NAgame.camera as _camera

classify Scene: (
    df __init__(urself, name): (
        urself.name = name
        urself.data = {}
    )
)

_scenes = {}
_current = None

df _inside(point, x, y, width, height): (
    ret point[0] >= x and point[0] < x + width and point[1] >= y and point[1] < y + height
)

df btn(text, x, y, width = 160, height = 44, onclick = None): (
    hover = _inside(_inp.mse(), x, y, width, height)
    clicked = hover and _inp.mseclk(1)
    mode = "normal"
    if clicked: (
        mode = "pressed"
    )
    else if hover: (
        mode = "hover"
    )
    _ui.draw_button(x, y, width, height, str(text), mode)
    if clicked and onclick is not None: (
        onclick()
    )
    ret clicked
)

df panel(x, y, width, height, title = ""): (
    _ui.draw_panel(x, y, width, height, str(title))
    ret _utils.Shape("rec", x, y, width, height, 0)
)

df menu(items, x, y, width = 220, height = 44, spacing = 10): (
    chosen = -1
    for i in rang(len(items)): (
        top = y + i * (height + spacing)
        if btn(items[i], x, top, width, height): (
            chosen = i
        )
    )
    ret chosen
)

df scn(name = None): (
    glob _current
    if name is None: (
        ret _current
    )
    if name not in _scenes: (
        _scenes[name] = Scene(name)
    )
    _current = _scenes[name]
    ret _current
)

df savscn(path): (
    if _current is None: (
        perror RuntimeError("savscn(): nenhuma cena ativa; use scn(nome)")
    )
    _ui.write_text(path, _json.dumps({"scene": _current.name, "data": _current.data}, indent = 2))
)

df loadscn(path): (
    content = _json.loads(_ui.read_text(path))
    scene = scn(content["scene"])
    scene.data = content["data"]
    ret scene
)

df gameover(message = "GAME OVER"): (
    if message is None: (
        ret _utils._state["over"]
    )
    _utils._state["over"] = True
    _utils._state["message"] = str(message)
    ret True
)

df restart(): (
    _utils._state["over"] = False
    _utils._state["message"] = "GAME OVER"
    _utils._clear(_utils._updaters)
    _utils._clear(_utils._overlays)
    _camera._reset()
    if _current is not None: (
        _current.data = {}
    )
)
